    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const original = $('Build Customer Excel').last().binary.data;\nconst editedKeys = Object.keys($input.item.binary || {});\nconst useEdited = $json.Decision === 'Edited and approve' && editedKeys.length > 0;\nconst file = useEdited ? $input.item.binary[editedKeys[0]] : original;\nconst customer = $('Process One Customer').last().json.Owner;\nconst TEST_EMAIL = 'test-recipient@example.com';\nconst realEmail = String($('Find Customer Email').last().json.Email).replace(/;/g, ',');\nconst toEmail = TEST_EMAIL || realEmail;\nreturn { json: { customer, toEmail, usedEditedFile: useEdited }, binary: { approved_excel: file } };"
      },
