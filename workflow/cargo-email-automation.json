        "schemaType": "manual",
        "inputSchema": "{\"type\": \"object\", \"properties\": {\"shipments\": {\"type\": \"array\", \"description\": \"One entry for every separate shipment in the email, even if they belong to different customers\", \"items\": {\"type\": \"object\", \"properties\": {\"owner\": {\"type\": \"string\", \"description\": \"Customer / owner name the shipment belongs to\"}, \"reference_no\": {\"type\": \"string\", \"description\": \"Reference number\"}, \"agent_ref\": {\"type\": \"string\", \"description\": \"Agent reference\"}, \"nomination_date\": {\"type\": \"string\", \"description\": \"Nomination date\"}, \"shipper\": {\"type\": \"string\", \"description\": \"Shipper name\"}, \"invoice_number\": {\"type\": \"string\", \"description\": \"Invoice number\"}, \"pol\": {\"type\": \"string\", \"description\": \"Port of loading\"}, \"pod\": {\"type\": \"string\", \"description\": \"Port of discharge\"}, \"terms\": {\"type\": \"string\", \"description\": \"Shipping terms such as FOB, CFR, CIF\"}, \"fcl\": {\"type\": \"string\", \"description\": \"Container count and type, e.g. 1x20GP\"}, \"etl\": {\"type\": \"string\", \"description\": \"Estimated time of loading / departure\"}, \"eta\": {\"type\": \"string\", \"description\": \"Estimated time of arrival\"}, \"vessel_flight\": {\"type\": \"string\", \"description\": \"Vessel or flight name and voyage\"}, \"routing\": {\"type\": \"string\", \"description\": \"Routing\"}, \"hbl_hawb\": {\"type\": \"string\", \"description\": \"House bill of lading or air waybill number\"}, \"surrender_status\": {\"type\": \"string\", \"description\": \"Surrender status of the bill of lading\"}, \"container_number\": {\"type\": \"string\", \"description\": \"Container number(s)\"}, \"carrier_airline\": {\"type\": \"string\", \"description\": \"Carrier or airline\"}, \"final_hbl_send\": {\"type\": \"string\", \"description\": \"Whether the final HBL has been sent, Yes or No\"}, \"status\": {\"type\": \"string\", \"description\": \"Current shipment status\"}, \"remarks\": {\"type\": \"string\", \"description\": \"Remarks or notes\"}}, \"required\": [\"owner\"]}}}, \"required\": [\"shipments\"]}",
        "options": {}
