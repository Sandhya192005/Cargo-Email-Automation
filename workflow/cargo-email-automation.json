      "parameters": {
        "jsCode": "const seen = new Set();\nconst out = [];\nfor (const i of $('Flatten Extracted Data').all()) {\n  const owner = String(i.json.Owner || '').trim();\n  const key = owner.toLowerCase();\n  if (owner && !seen.has(key)) { seen.add(key); out.push({ json: { Owner: owner } }); }\n}\nreturn out;"
      },
